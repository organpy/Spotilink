# Server
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DATABASE_PATH=./data/resolver.db

# HTTP client
HTTP_USER_AGENT=spotilink/0.1
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_MAX_RETRIES=1
HTTP_RETRY_BACKOFF_SECONDS=0.5
HTTP_RETRY_AFTER_CAP_SECONDS=2

# Spotify public-page extraction
SPOTIFY_TIMEOUT_SECONDS=10
SPOTIFY_MAX_BYTES=2097152
SPOTIFY_MAX_REDIRECTS=3

# YouTube Data API v3. Required for YouTube resolution.
YOUTUBE_API_KEY=
YOUTUBE_MAX_RESULTS=10
YOUTUBE_MAX_QUERIES=1
YOUTUBE_RATE_LIMIT_PER_MINUTE=10
YOUTUBE_RATE_LIMIT_BURST=2

# SoundCloud official API (OAuth 2.1 client credentials).
# Registering an API app currently requires a SoundCloud Artist Pro subscription.
# Leave these blank to run YouTube-only.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_MAX_RESULTS=20
SOUNDCLOUD_MAX_QUERIES=2
SOUNDCLOUD_RATE_LIMIT_PER_MINUTE=30
SOUNDCLOUD_RATE_LIMIT_BURST=2

# Providers
PROVIDER_TIMEOUT_SECONDS=8
PROVIDER_MAX_BYTES=1048576
PROVIDER_RATE_LIMIT_WAIT_SECONDS=2

# Matching
MATCH_THRESHOLD=0.80
WEIGHT_TITLE=0.50
WEIGHT_ARTIST=0.35
WEIGHT_DURATION=0.15
OFFICIAL_BONUS=0.06
MIN_TITLE_SCORE=0.65
MIN_ARTIST_SCORE=0.50
NO_DURATION_SCORE_CAP=0.85
REQUIRE_DURATION=true
SEARCH_EXTRA_QUERY_MARGIN=0.10
YOUTUBE_MAX_DURATION_DIFF_MS=30000
SOUNDCLOUD_MAX_DURATION_DIFF_MS=15000

# Cache
MATCH_CACHE_TTL_SECONDS=604800
METADATA_CACHE_TTL_SECONDS=604800
NEGATIVE_CACHE_TTL_SECONDS=3600
SPOTIFY_NOT_FOUND_CACHE_TTL_SECONDS=300
# Extra time an expired verified match may be served when a provider fails.
# Set to 0 to disable stale matches.
STALE_MATCH_GRACE_SECONDS=2592000

# API
RESOLVE_TIMEOUT_SECONDS=30
API_RATE_LIMIT_PER_MINUTE=60
TRUST_PROXY_HEADERS=false
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# v2: playlists, ytmusicapi fallback and background jobs
# ---------------------------------------------------------------------------

# YouTube Music (ytmusicapi). Used for Spotify playlist matching and as an
# automatic fallback for single tracks when the YouTube Data API fails.
# Spotify playlists cannot be processed when this is false.
YT_MUSIC_ENABLED=true
YT_MUSIC_CONCURRENCY=3
YT_MUSIC_TIMEOUT_SECONDS=10
YT_MUSIC_MAX_RESULTS=10
YT_MUSIC_RETRY_BACKOFF_SECONDS=2
# Playlist matching: confidence >= MATCH_THRESHOLD is "matched"; between the
# two thresholds it is returned as "uncertain" (never as a confident match).
YT_MUSIC_MATCH_THRESHOLD=0.75
YT_MUSIC_UNCERTAIN_THRESHOLD=0.60
YT_MUSIC_WEIGHT_TITLE=0.45
YT_MUSIC_WEIGHT_ARTIST=0.35
YT_MUSIC_WEIGHT_DURATION=0.20

# Seconds the primary YouTube Data API resolver is skipped after quota
# exhaustion or an upstream rate limit (a longer Retry-After wins).
PRIMARY_RESOLVER_COOLDOWN=300

# Spotify playlist extraction: auto | spotify_downloader | webplayer
SPOTIFY_PLAYLIST_EXTRACTOR=auto
SPOTIFY_WEBPLAYER_FALLBACK=true
# Last resort: first 100 tracks from the public embed page, always reported
# as extraction_complete=false.
SPOTIFY_EMBED_PARTIAL_FALLBACK=true
SPOTIFY_PLAYLIST_PAGE_SIZE=100
# Optional: pin the web-player persisted-query hash instead of discovering it.
SPOTIFY_WEBPLAYER_QUERY_HASH=

# YouTube playlist extraction (yt-dlp, flat metadata only)
YOUTUBE_PLAYLIST_TIMEOUT_SECONDS=90

# Jobs
PLAYLIST_MAX_TRACKS=1000
PLAYLIST_MAX_CONCURRENT_JOBS=2
PLAYLIST_MAX_PENDING_JOBS=50
# Complete playlists are reused for this long; incomplete ones only briefly.
PLAYLIST_CACHE_TTL=86400
PLAYLIST_PARTIAL_CACHE_TTL=600
JOB_TTL_SECONDS=259200
JOB_LEASE_SECONDS=120
RESOLVER_CACHE_ENABLED=true

# POST /v2/resolve requests per client per minute (0 disables)
V2_RATE_LIMIT_PER_MINUTE=20
